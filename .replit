# CinemaOS Frontend — Replit configuration
# Runs the Next.js frontend that communicates with the FastAPI backend.
run = "npm run dev"
language = "nodejs"
entrypoint = "src/app/page.tsx"

[nix]
channel = "24.05"

[env]
NODE_ENV = "development"
NEXT_PUBLIC_API_BASE_URL = "https://cinemaos-backend-614628729668.us-central1.run.app"

[[ports]]
localPort = 3000
externalPort = 80

[deployment]
run = ["sh", "-c", "npm install && npm run build && npm run start"]
deploymentTarget = "local"
